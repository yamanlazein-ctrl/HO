# ============================================================
# AI-Based CCTV Littering Detection and Evidence System
# Environment configuration — copy to .env and adjust as needed
# ============================================================

# --- Database (PostgreSQL) ---
# Local Docker:  docker-compose up -d postgres
# External:      point this to your remote Postgres instance
DATABASE_URL=postgresql://litter:litter@localhost:5432/littering

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Dashboard (Vite dev server) ---
DASHBOARD_PORT=5173

# --- Camera ---
# OpenCV device index (0 = default webcam; Camo/Iriun virtual camera may be 1 or 2)
CAMERA_DEVICE_INDEX=0

# --- Inference engine ---
ANALYSIS_FPS=10
BUFFER_SECONDS=6
PRE_EVENT_SECONDS=3
POST_EVENT_SECONDS=3

# --- Model weights ---
# best.pt: custom YOLO litter-detection weights (download from reference repo)
# yolov8n.pt: COCO person-detection weights (auto-downloads on first use if missing)
LITTER_WEIGHTS=inference/detection/weights/best.pt
PERSON_WEIGHTS=yolov8n.pt
